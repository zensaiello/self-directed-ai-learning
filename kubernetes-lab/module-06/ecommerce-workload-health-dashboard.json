{
  "title": "E-Commerce Workload Health",
  "description": "Application-scoped health dashboard for the e-commerce workloads. Filters to namespace=default. Covers product catalog availability, postgres health, storage status, and deployment events.",
  "tags": ["ecommerce", "application", "kubernetes"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Product Catalog — Replica Availability",
      "description": "Ratio of available replicas to desired replicas. 1.0 = fully available. Below 1.0 = degraded.",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": []
        }
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"default\", deployment=\"product-catalog\"} / kube_deployment_spec_replicas{namespace=\"default\", deployment=\"product-catalog\"}",
          "legendFormat": "Availability",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Product Catalog — Available Replicas",
      "description": "Current number of available replicas vs desired.",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Available" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Desired" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"default\", deployment=\"product-catalog\"}",
          "legendFormat": "Available",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"default\", deployment=\"product-catalog\"}",
          "legendFormat": "Desired",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "PostgreSQL — StatefulSet Ready",
      "description": "Number of ready postgres replicas. 1 = healthy. 0 = database unavailable.",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "kube_statefulset_status_replicas_ready{namespace=\"default\", statefulset=\"postgres\"}",
          "legendFormat": "postgres ready replicas",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "PostgreSQL — PVC Status",
      "description": "PVC binding status. 1 = Bound (healthy). 0 = not bound (storage problem).",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NOT BOUND", "color": "red" }, "1": { "text": "BOUND", "color": "green" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "kube_persistentvolumeclaim_status_phase{namespace=\"default\", persistentvolumeclaim=\"postgres-data-postgres-0\", phase=\"Bound\"}",
          "legendFormat": "postgres-data-postgres-0",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Pod Restart Count — E-Commerce Workloads",
      "description": "Cumulative container restarts per Pod in the default namespace. Sustained increases indicate instability. Any restart warrants investigation.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "kube_pod_container_status_restarts_total{namespace=\"default\"}",
          "legendFormat": "{{pod}} / {{container}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Pod CPU Usage — E-Commerce Workloads",
      "description": "CPU cores consumed per Pod in the default namespace. Sustained high usage without limits set is a risk — see Module 8 for resource limits.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"default\", container!=\"\", container!=\"POD\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Pod Memory Usage — E-Commerce Workloads",
      "description": "Working set memory per Pod in the default namespace. Working set excludes reclaimable cache — it is the memory the OS cannot reclaim under pressure.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"default\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Log Collector DaemonSet Coverage",
      "description": "Number of ready log-collector Pods vs desired. Should always equal the node count. A gap means a node has no log collection.",
      "type": "stat",
      "gridPos": { "x": 12, "y": 12, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 4 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "kube_daemonset_status_number_ready{namespace=\"default\", daemonset=\"log-collector\"}",
          "legendFormat": "Ready",
          "refId": "A"
        },
        {
          "expr": "kube_daemonset_status_desired_number_scheduled{namespace=\"default\", daemonset=\"log-collector\"}",
          "legendFormat": "Desired",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "Deployment Rollout Events",
      "description": "Tracks when Deployments in the default namespace were last updated. Correlate with restart spikes or availability drops to identify whether a rollout caused an issue.",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "expr": "kube_deployment_status_observed_generation{namespace=\"default\"}",
          "legendFormat": "{{deployment}} generation",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Workload Health Summary",
      "description": "Quick reference status of all e-commerce workloads. Red = problem. Green = healthy.",
      "type": "table",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "options": {
        "footer": { "show": false },
        "showHeader": true,
        "sortBy": [{ "displayName": "Workload", "desc": false }]
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "custom": {
            "displayMode": "color-background"
          }
        }
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"default\"}",
          "legendFormat": "{{deployment}}",
          "refId": "A",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": { "valueLabel": "deployment" }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "deployment": "Workload",
              "Value": "Available Replicas"
            }
          }
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Datasource",
        "current": {}
      }
    ]
  },
  "schemaVersion": 39,
  "version": 1
}
